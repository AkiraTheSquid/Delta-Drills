    {
      "id": 50045,
      "kind": "statement",
      "difficulty": 25,
      "prompt": "Which target is in the span of (1, 2) and (2, 4)?",
      "choices": [
        {
          "key": "A",
          "text": "(1, 0)"
        },
        {
          "key": "B",
          "text": "(3, 6)"
        },
        {
          "key": "C",
          "text": "(0, 1)"
        },
        {
          "key": "D",
          "text": "(2, 3)"
        }
      ],
      "answer": "B",
      "solution": "Both generators lie on y = 2x, so their span is exactly that line. Only (3, 6) satisfies the relation."
    },
    {
      "id": 50046,
      "kind": "compute",
      "difficulty": 40,
      "prompt": "Let E1 = (2, 0), E2 = (1, 3). Which (u, v) gives uE1 + vE2 = (7, 3)?",
      "choices": [
        {
          "key": "A",
          "text": "(7, 3)",
          "value": "Matrix([7,3])"
        },
        {
          "key": "B",
          "text": "(2, 1)",
          "value": "Matrix([2,1])"
        },
        {
          "key": "C",
          "text": "(3, 1)",
          "value": "Matrix([3,1])"
        },
        {
          "key": "D",
          "text": "(1, 3)",
          "value": "Matrix([1,3])"
        }
      ],
      "answer": "C",
      "solution": "The y-equation gives v = 1; then 2u + 1 = 7 gives u = 3. Standard components are not these basis coordinates.",
      "verify": {
        "sympy": {
          "truth": "Matrix([[2,1],[0,3]]).inv()*Matrix([7,3])"
        }
      }
    },
    {
      "id": 50047,
      "kind": "statement",
      "difficulty": 40,
      "prompt": "What is the span of (1, 0, 0) and (0, 1, 0) with unrestricted real weights?",
      "choices": [
        {
          "key": "A",
          "text": "All of 3D space."
        },
        {
          "key": "B",
          "text": "Only points with x ≥ 0 and y ≥ 0."
        },
        {
          "key": "C",
          "text": "Only the line x = y, z = 0."
        },
        {
          "key": "D",
          "text": "The whole plane z = 0."
        }
      ],
      "answer": "D",
      "solution": "A combination is (u, v, 0), for any real u and v. No z component is available, and weights need not be positive."
