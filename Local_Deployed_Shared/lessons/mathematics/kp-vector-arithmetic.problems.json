        },
        {
          "key": "B",
          "text": "(3, 1, 0)",
          "value": "Matrix([3,1,0])"
        },
        {
          "key": "C",
          "text": "(4, 2, 1)",
          "value": "Matrix([4,2,1])"
        },
        {
          "key": "D",
          "text": "(8, 4, 2)",
          "value": "Matrix([8,4,2])"
        }
      ],
      "answer": "B",
