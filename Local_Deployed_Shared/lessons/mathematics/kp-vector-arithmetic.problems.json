    {
      "id": 50034,
      "kind": "compute",
      "difficulty": 40,
      "prompt": "A = (−1, 2, 4), B = (3, −1, 6). Find the displacement from A to B.",
      "choices": [
        {
          "key": "A",
          "text": "(2, 1, 10)",
          "value": "Matrix([2,1,10])"
        },
        {
          "key": "B",
          "text": "(−4, 3, −2)",
          "value": "Matrix([-4,3,-2])"
        },
        {
          "key": "C",
          "text": "(4, −3, 2)",
          "value": "Matrix([4,-3,2])"
        },
        {
          "key": "D",
          "text": "(4, 3, 2)",
          "value": "Matrix([4,3,2])"
        }
      ],
      "answer": "C",
      "solution": "Use B − A = (4, −3, 2). Adding positions is not a displacement; A − B points the other way.",
      "verify": {
        "sympy": {
          "truth": "Matrix([3,-1,6])-Matrix([-1,2,4])"
        }
      }
    },
    {
      "id": 50035,
      "kind": "compute",
      "difficulty": 40,
      "prompt": "Let p = (1, −2), u = (3, 1), v = (−1, 4). Find p + 2u − v.",
      "choices": [
        {
          "key": "A",
          "text": "(6, 4)",
          "value": "Matrix([6,4])"
        },
        {
          "key": "B",
          "text": "(8, −6)",
          "value": "Matrix([8,-6])"
        },
        {
          "key": "C",
          "text": "(5, −5)",
          "value": "Matrix([5,-5])"
        },
        {
          "key": "D",
          "text": "(8, −4)",
          "value": "Matrix([8,-4])"
        }
      ],
      "answer": "D",
      "solution": "First 2u = (6, 2). Subtracting v adds 1 to x and subtracts 4 from y: (8, −4).",
