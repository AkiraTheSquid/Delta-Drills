{
  "kc": "math.matrix-equations",
  "problems": [
    {
      "id": 50050,
      "kind": "compute",
      "difficulty": 25,
      "prompt": "M has rows (1, 2) and (−1, 3). Find M(2, −1).",
      "choices": [
        {
          "key": "A",
          "text": "(0, 1)",
          "value": "Matrix([0,1])"
        },
        {
          "key": "B",
          "text": "(4, −5)",
          "value": "Matrix([4,-5])"
        },
        {
          "key": "C",
          "text": "(0, −5)",
          "value": "Matrix([0,-5])"
        },
        {
          "key": "D",
          "text": "(3, −1)",
          "value": "Matrix([3,-1])"
        }
      ],
      "answer": "C",
      "solution": "Row 1 gives 2 − 2 = 0; row 2 gives −2 − 3 = −5. A matrix product combines rows with all input components.",
      "verify": {
        "sympy": {
          "truth": "Matrix([[1,2],[-1,3]])*Matrix([2,-1])"
        }
      }
    },
    {
      "id": 50051,
      "kind": "compute",
      "difficulty": 25,
      "prompt": "For unknown order (u, v), which matrix encodes 3u − 2v = 7 and u + 4v = 5? Matrices are written as rows.",
      "choices": [
        {
          "key": "A",
          "text": "((3, 1), (−2, 4))",
          "value": "Matrix([[3,1],[-2,4]])"
        },
        {
          "key": "B",
          "text": "((3, 2), (1, 4))",
          "value": "Matrix([[3,2],[1,4]])"
        },
        {
          "key": "C",
          "text": "((7, 5), (3, 4))",
          "value": "Matrix([[7,5],[3,4]])"
        },
        {
          "key": "D",
          "text": "((3, −2), (1, 4))",
          "value": "Matrix([[3,-2],[1,4]])"
        }
      ],
      "answer": "D",
      "solution": "Each row lists coefficients in order u, v. The first distractor transposes the matrix; the others lose a sign or mix in the right-hand side.",
      "verify": {
        "sympy": {
          "truth": "Matrix([[3,-2],[1,4]])"
        }
      }
    },
    {
      "id": 50052,
      "kind": "compute",
      "difficulty": 40,
      "prompt": "Solve u + v = 5 and 2u − v = 1. Choose (u, v).",
      "choices": [
        {
          "key": "A",
          "text": "(2, 3)",
          "value": "Matrix([2,3])"
        },
        {
          "key": "B",
          "text": "(3, 2)",
          "value": "Matrix([3,2])"
        },
        {
          "key": "C",
          "text": "(1, 4)",
          "value": "Matrix([1,4])"
        },
        {
          "key": "D",
          "text": "(2, −3)",
          "value": "Matrix([2,-3])"
        }
      ],
      "answer": "A",
      "solution": "Add the equations: 3u = 6, so u = 2; then v = 3. Both equations must hold.",
      "verify": {
        "sympy": {
          "truth": "Matrix([[1,1],[2,-1]]).inv()*Matrix([5,1])"
        }
      }
    },
    {
      "id": 50053,
      "kind": "compute",
      "difficulty": 40,
      "prompt": "For M with rows (2, 1), (1, −1), candidate x = (1, 2), and b = (5, 1), find the residual Mx − b.",
      "choices": [
        {
          "key": "A",
          "text": "(0, 0)",
          "value": "Matrix([0,0])"
        },
        {
          "key": "B",
          "text": "(−1, −2)",
          "value": "Matrix([-1,-2])"
        },
        {
          "key": "C",
          "text": "(1, 2)",
          "value": "Matrix([1,2])"
        },
        {
          "key": "D",
          "text": "(4, −1)",
          "value": "Matrix([4,-1])"
        }
      ],
      "answer": "B",
      "solution": "Mx = (4, −1); subtract b to get (−1, −2). The candidate fails the equations. Mx alone is not the residual.",
      "verify": {
        "sympy": {
          "truth": "Matrix([[2,1],[1,-1]])*Matrix([1,2])-Matrix([5,1])"
        }
      }
    },
