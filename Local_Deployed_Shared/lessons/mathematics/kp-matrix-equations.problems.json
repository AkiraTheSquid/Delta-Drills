    {
      "id": 50055,
      "kind": "statement",
      "difficulty": 55,
      "prompt": "A 3-by-2 matrix has two independent columns. Which statement about Mx = b is correct?",
      "choices": [
        {
          "key": "A",
          "text": "x has three components and b has two."
        },
        {
          "key": "B",
          "text": "Every 3D b has a solution."
        },
        {
          "key": "C",
          "text": "Every reachable b has infinitely many solutions."
        },
        {
          "key": "D",
          "text": "x has two components; b has three; a solution exists only when b is in the column span, and is then unique."
        }
      ],
      "answer": "D",
      "solution": "Two independent columns span a plane in 3D. They give unique coefficients for reachable b, but cannot reach every 3D vector. A matrix need not be square to describe a linear map."
    }
