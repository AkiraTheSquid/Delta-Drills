      <graph edgedefault="directed" id="g_part-5:">
        <node id="encoder-decoder-symmetric">
          <data key="d_id">encoder-decoder-symmetric</data>
          <data key="d_label">mirrored conv / transposed-conv stack</data>
          <data key="d_definition">Autoencoder/VAE/GAN-generator pattern: encoder downsamples via Conv2d(stride=2), decoder mirrors via ConvTranspose2d(stride=2) with same channel counts in reverse. The defining structural symmetry of every reconstruction/generation model.</data>
          <data key="d_domain">generative-architecture</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85F2A1" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">mirrored conv / transposed-conv stack</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="bottleneck-latent-projection">
          <data key="d_id">bottleneck-latent-projection</data>
          <data key="d_label">flatten -&gt; Linear(hidden) -&gt; Linear(latent)</data>
          <data key="d_definition">End-of-encoder pattern: Rearrange('b c h w -&gt; b (c h w)') then two Linears with ReLU between to project conv features down to the latent dimension. Mirror in decoder to expand back.</data>
          <data key="d_domain">generative-architecture</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85F2A1" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">flatten -&gt; Linear(hidden) -&gt; Linear(latent)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="rearrange-as-sequential-layer">
          <data key="d_id">rearrange-as-sequential-layer</data>
          <data key="d_label">einops.layers.torch.Rearrange in nn.Sequential</data>
          <data key="d_definition">Use Rearrange('b c h w -&gt; b (c h w)') (and inverse) as a stateless module inside nn.Sequential so flatten/unflatten lives in the module list rather than forward(). The canonical idiom for keeping forward() trivial.</data>
          <data key="d_domain">generative-architecture</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85F2A1" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">einops.layers.torch.Rearrange in nn.Sequential</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="no-relu-on-final-layer">
          <data key="d_id">no-relu-on-final-layer</data>
          <data key="d_label">last decoder/generator layer is bare</data>
          <data key="d_definition">The very last ConvTranspose2d (or Linear) in a decoder/generator has no ReLU/activation after it; the model needs freedom to produce any output value, not just non-negative ones. Common gotcha when copy-pasting block patterns.</data>
          <data key="d_domain">generative-architecture</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85F2A1" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">last decoder/generator layer is bare</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="mu-logsigma-encoder-head">
          <data key="d_id">mu-logsigma-encoder-head</data>
          <data key="d_label">encoder outputs (mu, logsigma) pair</data>
          <data key="d_definition">Replace single-vector encoder output with TWO vectors of size latent_dim: mean mu and log std logsigma. Implemented by doubling the final Linear out_features then Rearrange('b (n d) -&gt; n b d', n=2).</data>
          <data key="d_domain">vae-math</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#C885F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">encoder outputs (mu, logsigma) pair</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="reparameterization-trick">
          <data key="d_id">reparameterization-trick</data>
          <data key="d_label">z = mu + sigma * randn_like(sigma)</data>
          <data key="d_definition">Sample latents in a way that keeps gradients flowing: draw eps ~ N(0,1), then z = mu + exp(logsigma) * eps. eps is non-learnable so backprop sees z as a deterministic function of (mu, logsigma). The single defining trick of VAEs.</data>
          <data key="d_domain">vae-math</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#C885F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">z = mu + sigma * randn_like(sigma)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="kl-divergence-gaussian-closed-form">
          <data key="d_id">kl-divergence-gaussian-closed-form</data>
          <data key="d_label">0.5 * (mu^2 + exp(2*logsigma) - 1) - logsigma</data>
          <data key="d_definition">Analytic KL between N(mu, sigma^2) and N(0, 1), per-element. Mean over batch to get the loss term. The 'regularize latents toward standard normal' half of the VAE objective.</data>
          <data key="d_domain">vae-math</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#C885F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">0.5 * (mu^2 + exp(2*logsigma) - 1) - logsigma</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="elbo-loss-sum-with-beta">
          <data key="d_id">elbo-loss-sum-with-beta</data>
          <data key="d_label">loss = recon_loss + beta_kl * kl_loss</data>
          <data key="d_definition">Total VAE loss is reconstruction + a beta-weighted KL term. beta_kl is a scalar hparam; tuning it trades reconstruction sharpness vs latent-space regularity.</data>
          <data key="d_domain">vae-math</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#C885F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">loss = recon_loss + beta_kl * kl_loss</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="randn-like-noise-source">
          <data key="d_id">randn-like-noise-source</data>
          <data key="d_label">t.randn_like(sigma) for matched-shape noise</data>
          <data key="d_definition">Generate standard-normal noise with the same shape, dtype, and device as an existing tensor; the canonical 'where do I get eps from' answer in VAE reparam + GAN-generator latent sampling.</data>
          <data key="d_domain">vae-math</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-?</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#C885F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">t.randn_like(sigma) for matched-shape noise</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="generator-project-and-reshape">
          <data key="d_id">generator-project-and-reshape</data>
          <data key="d_label">latent_dim -&gt; (C, H0, W0) via Linear + Rearrange</data>
          <data key="d_definition">First layer of DCGAN generator: Linear(latent_dim, C*H0*W0, bias=False) followed by Rearrange('b (c h w) -&gt; b c h w'), BatchNorm2d, ReLU. Transforms 1D latent into a small feature map ready for transposed convs.</data>
          <data key="d_domain">gan-architecture</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
