              <y:Fill color="#CBF285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">@t.inference_mode() log_samples(self)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
