        <node id="two-optimizers-alternating-step">
          <data key="d_id">two-optimizers-alternating-step</data>
          <data key="d_label">self.optG + self.optD, alternating</data>
          <data key="d_definition">DCGAN has one Adam optimizer per network; each iteration calls optD.zero_grad() -&gt; D loss -&gt; D.step(), then optG.zero_grad() -&gt; G loss -&gt; G.step(). The two networks train independently in the same loop.</data>
          <data key="d_domain">gan-training</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
