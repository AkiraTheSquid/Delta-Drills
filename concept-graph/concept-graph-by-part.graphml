              <y:Fill color="#B9F285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">latent_dim -&gt; (C, H0, W0) via Linear + Rearrange</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="convtranspose-bn-activation-block">
          <data key="d_id">convtranspose-bn-activation-block</data>
          <data key="d_label">ConvT -&gt; BatchNorm -&gt; ReLU/Tanh</data>
          <data key="d_definition">Canonical generator block: doubles spatial size, normalizes, applies activation. Tanh (not ReLU) on the very last block so output is in [-1, 1] matching Normalize((0.5,...), (0.5,...)) preprocessing.</data>
          <data key="d_domain">gan-architecture</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#B9F285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">ConvT -&gt; BatchNorm -&gt; ReLU/Tanh</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="conv-leakyrelu-block-discriminator">
          <data key="d_id">conv-leakyrelu-block-discriminator</data>
          <data key="d_label">Conv -&gt; (BN) -&gt; LeakyReLU</data>
          <data key="d_definition">Canonical DCGAN discriminator block: stride-2 conv to halve spatial size, BatchNorm (skipped on first layer), LeakyReLU(0.2) as the activation. The downsampling mirror of the generator block.</data>
          <data key="d_domain">gan-architecture</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="224.0" x="0.0" y="0.0"/>
              <y:Fill color="#B9F285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">Conv -&gt; (BN) -&gt; LeakyReLU</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="discriminator-classifier-head">
          <data key="d_id">discriminator-classifier-head</data>
          <data key="d_label">flatten -&gt; Linear(1) -&gt; Sigmoid</data>
          <data key="d_definition">End-of-discriminator: Rearrange('b c h w -&gt; b (c h w)'), Linear(final_size, 1, bias=False), Sigmoid(). Produces a per-image real/fake probability scalar.</data>
          <data key="d_domain">gan-architecture</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#B9F285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">flatten -&gt; Linear(1) -&gt; Sigmoid</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="dcgan-wrapper-netG-netD">
          <data key="d_id">dcgan-wrapper-netG-netD</data>
          <data key="d_label">DCGAN(nn.Module) with .netG / .netD</data>
          <data key="d_definition">Thin wrapper module that holds both generator (self.netG) and discriminator (self.netD) as submodules but has no forward() — callers invoke model.netG(...) and model.netD(...) directly. The 2-network-in-one-Module idiom.</data>
          <data key="d_domain">gan-architecture</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#B9F285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">DCGAN(nn.Module) with .netG / .netD</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="channel-list-reverse-build">
          <data key="d_id">channel-list-reverse-build</data>
          <data key="d_label">hidden_channels reversed for generator</data>
          <data key="d_definition">Generator and discriminator share a hidden_channels list; discriminator builds in given order (innermost to outermost = chronological for downsampler), generator reverses it before iterating. 'Configure both halves from one list' pattern.</data>
          <data key="d_domain">gan-architecture</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#B9F285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">hidden_channels reversed for generator</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="bce-log-loss-real-fake">
          <data key="d_id">bce-log-loss-real-fake</data>
          <data key="d_label">-log(D(x)).mean() - log(1-D(G(z))).mean()</data>
          <data key="d_definition">Discriminator loss: maximize log(D(real)) + log(1-D(fake)) &lt;-&gt; minimize the negative. Manual log-form (not nn.BCELoss) because the labels are constant 1s and 0s. The defining minimax objective term.</data>
          <data key="d_domain">gan-training</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85F2AE" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">-log(D(x)).mean() - log(1-D(G(z))).mean()</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="generator-loss-fool-discriminator">
          <data key="d_id">generator-loss-fool-discriminator</data>
          <data key="d_label">-log(D(G(z))).mean()</data>
          <data key="d_definition">Generator loss: maximize log(D(G(z))) &lt;-&gt; minimize the negative. NOT -log(1-D(G(z))) (the symmetric form) — the standard 'non-saturating' trick to give the generator stronger gradients early in training.</data>
          <data key="d_domain">gan-training</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="184.0" x="0.0" y="0.0"/>
              <y:Fill color="#85F2AE" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">-log(D(G(z))).mean()</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="detach-stop-gradient-trick">
          <data key="d_id">detach-stop-gradient-trick</data>
          <data key="d_label">img_fake.detach() into discriminator</data>
          <data key="d_definition">When training the discriminator on fake images, pass img_fake.detach() so backprop through the loss only updates D, not G. Without detach the generator would receive an update from D's own gradient step, which is wrong. The single most-recognizable GAN-training idiom.</data>
          <data key="d_domain">gan-training</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
