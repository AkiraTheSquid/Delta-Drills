        <node id="logsumexp-cross-entropy">
          <data key="d_id">logsumexp-cross-entropy</data>
          <data key="d_label">logprobs = logits - logsumexp(logits, dim=-1)</data>
          <data key="d_definition">Cross-entropy via the log-softmax identity: logprobs[i,j] = logits[i,j] - log(sum(exp(logits[i,:]))), then negate the indexed correct-label logprobs.</data>
          <data key="d_domain">custom-autograd-layers</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
