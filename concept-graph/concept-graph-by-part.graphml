        <node id="backward-fn-signature">
          <data key="d_id">backward-fn-signature</data>
          <data key="d_label">(grad_out, out, x, ...) -&gt; grad_in</data>
          <data key="d_definition">Every backward function takes grad_out (dL/d(out)), out (the forward output), and the original positional args of the forward fn; returns the gradient wrt one specific input. Canonical per-op rule signature.</data>
          <data key="d_domain">backward-rule-pattern</data>
          <data key="d_status">accepted</data>
