              <y:Fill color="#F285BD" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">x @ self.weight.T + self.bias</y:NodeLabel>
