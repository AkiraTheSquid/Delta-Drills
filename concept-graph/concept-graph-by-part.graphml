        <node id="noise-batch-from-latent">
          <data key="d_id">noise-batch-from-latent</data>
          <data key="d_label">t.randn(batch, latent_dim).to(device)</data>
          <data key="d_definition">Fresh random latent batch per training iteration: shape (batch_size, latent_dim_size), on device, NOT inside the model. Feeds the generator to produce a new fake batch each step.</data>
          <data key="d_domain">gan-training</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85F2AE" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">t.randn(batch, latent_dim).to(device)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
