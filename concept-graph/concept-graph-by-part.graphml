        </node>
        <node id="recipe-dataclass">
          <data key="d_id">recipe-dataclass</data>
          <data key="d_label">Recipe(func, args, kwargs, parents)</data>
          <data key="d_definition">A @dataclass capturing exactly the data needed to run the backward pass for one node: the forward fn, its raw-array args, kwargs, and a {arg_idx: parent_tensor} dict.</data>
          <data key="d_domain">autograd-object</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85ABF2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">Recipe(func, args, kwargs, parents)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="requires-grad-propagation">
          <data key="d_id">requires-grad-propagation</data>
          <data key="d_label">OR over input flags &amp; global toggle</data>
          <data key="d_definition">out.requires_grad = grad_tracking_enabled AND is_differentiable AND any(input.requires_grad for input in args). A tensor needs grad iff tracking is on, the op is differentiable, AND at least one input needs grad.</data>
          <data key="d_domain">autograd-object</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85ABF2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">OR over input flags &amp; global toggle</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="grad-tracking-global-toggle">
          <data key="d_id">grad-tracking-global-toggle</data>
          <data key="d_label">grad_tracking_enabled module-level bool</data>
          <data key="d_definition">A process-wide flag (set/reset by NoGrad context manager); when False, no recipe is created and requires_grad is forced False. Equivalent of torch.no_grad().</data>
          <data key="d_domain">autograd-object</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85ABF2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">grad_tracking_enabled module-level bool</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="parents-dict-by-argidx">
          <data key="d_id">parents-dict-by-argidx</data>
          <data key="d_label">{argnum: parent_tensor} for Tensor inputs only</data>
          <data key="d_definition">Recipe.parents is a dict keyed by positional-arg-index, holding ONLY the Tensor inputs (skip ints/floats); lets backprop walk the right edges and dispatch the right _backN function.</data>
          <data key="d_domain">autograd-object</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85ABF2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">{argnum: parent_tensor} for Tensor inputs only</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="leaf-tensor-condition">
          <data key="d_id">leaf-tensor-condition</data>
          <data key="d_label">is_leaf = recipe is None and requires_grad</data>
          <data key="d_definition">Leaf tensors are user-created tensors (no recipe) that the user wants gradients on; they accumulate .grad rather than just propagating it.</data>
          <data key="d_domain">autograd-object</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85ABF2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">is_leaf = recipe is None and requires_grad</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="grad-accumulate-on-leaf">
          <data key="d_id">grad-accumulate-on-leaf</data>
          <data key="d_label">node.grad = grad_in if grad is None else grad + grad_in</data>
          <data key="d_definition">During backprop, leaf gradients accumulate (not overwrite) so multiple paths from L to the same leaf all contribute; implemented as 'create on first hit, else add'.</data>
          <data key="d_domain">autograd-object</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85ABF2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">node.grad = grad_in if grad is None else grad + grad_in</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="backward-func-lookup">
          <data key="d_id">backward-func-lookup</data>
          <data key="d_label">dict keyed by (forward_fn, arg_position)</data>
          <data key="d_definition">BackwardFuncLookup is essentially {(np.log, 0): log_back, (np.multiply, 0): multiply_back0, ...}; add_back_func / get_back_func are dict insert/lookup over that key.</data>
          <data key="d_domain">fwd-back-dispatcher</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85B6F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">dict keyed by (forward_fn, arg_position)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="wrap-forward-fn-generic">
          <data key="d_id">wrap-forward-fn-generic</data>
          <data key="d_label">numpy-fn -&gt; Tensor-fn factory</data>
          <data key="d_definition">wrap_forward_fn(numpy_func, is_differentiable=True) returns a closure that unboxes Tensor args to arrays, calls numpy_func, boxes the result, and attaches a Recipe. The single-most-leveraged factory in part 4.</data>
          <data key="d_domain">fwd-back-dispatcher</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="256.0" x="0.0" y="0.0"/>
              <y:Fill color="#85B6F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">numpy-fn -&gt; Tensor-fn factory</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="register-back-fn-after-wrap">
          <data key="d_id">register-back-fn-after-wrap</data>
          <data key="d_label">add_back_func(np.fn, argpos, back_fn) per new op</data>
          <data key="d_definition">Adding a new differentiable op: (a) wrap its forward with wrap_forward_fn, (b) register one _back per differentiable arg position. The 2-step 'extend the framework' idiom.</data>
          <data key="d_domain">fwd-back-dispatcher</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85B6F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">add_back_func(np.fn, argpos, back_fn) per new op</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="is-differentiable-flag">
          <data key="d_id">is-differentiable-flag</data>
          <data key="d_label">wrap_forward_fn(fn, is_differentiable=False)</data>
          <data key="d_definition">For argmax/equal etc., still wrap so unboxing/boxing happens, but skip Recipe construction entirely; output requires_grad is always False.</data>
          <data key="d_domain">fwd-back-dispatcher</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85B6F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">wrap_forward_fn(fn, is_differentiable=False)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="unbox-args-tensor-to-array">
          <data key="d_id">unbox-args-tensor-to-array</data>
          <data key="d_label">a.array if isinstance(a, Tensor) else a</data>
          <data key="d_definition">Inside wrap_forward_fn, map over args to extract underlying ndarrays (keeping non-Tensor scalars as-is) so numpy never sees a Tensor object.</data>
          <data key="d_domain">fwd-back-dispatcher</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85B6F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">a.array if isinstance(a, Tensor) else a</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="box-array-to-tensor-with-recipe">
          <data key="d_id">box-array-to-tensor-with-recipe</data>
          <data key="d_label">construct Tensor + attach Recipe</data>
          <data key="d_definition">After running the numpy fn, wrap the result in a Tensor, set requires_grad, and (iff requires_grad) build Recipe(func, arg_arrays, kwargs, parents) and assign it to out.recipe.</data>
          <data key="d_domain">fwd-back-dispatcher</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85B6F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">construct Tensor + attach Recipe</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="kwargs-pass-through-recipe">
          <data key="d_id">kwargs-pass-through-recipe</data>
          <data key="d_label">forward kwargs stored on Recipe, replayed in back fn</data>
          <data key="d_definition">Kwargs (e.g. dim, keepdim, axes, new_shape) must be forwarded both to numpy_func AND stored on the Recipe so backward fns can read them with the same names. The sum_back(dim=..., keepdim=...) failure mode.</data>
          <data key="d_domain">fwd-back-dispatcher</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85B6F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">forward kwargs stored on Recipe, replayed in back fn</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="dfs-three-set-toposort">
          <data key="d_id">dfs-three-set-toposort</data>
          <data key="d_label">perm / temp / result DFS pattern</data>
          <data key="d_definition">Classic depth-first topological sort: perm set = fully done, temp set = currently in DFS stack (cycle detector), result list = post-order append. Visit children before appending self.</data>
          <data key="d_domain">toposort-and-backprop</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#86F285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">perm / temp / result DFS pattern</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="cycle-detection-temp-set">
          <data key="d_id">cycle-detection-temp-set</data>
          <data key="d_label">raise on revisit in temp</data>
          <data key="d_definition">During DFS, if you reach a node already in the temp set, the graph has a cycle; raise. Distinguishes 'already done' (perm, return) from 'found cycle' (temp, raise).</data>
          <data key="d_domain">toposort-and-backprop</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="216.0" x="0.0" y="0.0"/>
              <y:Fill color="#86F285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">raise on revisit in temp</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="get-children-callable-param">
          <data key="d_id">get-children-callable-param</data>
          <data key="d_label">toposort takes get_children fn</data>
          <data key="d_definition">Decouple the toposort from the node type by passing get_children: Callable[[Node], list[Node]] as a parameter; lets the same fn work for Node (tests) and Tensor (real).</data>
          <data key="d_domain">toposort-and-backprop</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#86F285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">toposort takes get_children fn</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="sorted-computational-graph">
          <data key="d_id">sorted-computational-graph</data>
          <data key="d_label">reverse-topo from end_node via recipe.parents</data>
          <data key="d_definition">topological_sort(end_node, get_parents)[::-1] where get_parents(t) = list(t.recipe.parents.values()) returns Tensors in execution-friendly order (root first, leaves last).</data>
          <data key="d_domain">toposort-and-backprop</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#86F285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">reverse-topo from end_node via recipe.parents</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="backprop-pop-outgrad-loop">
          <data key="d_id">backprop-pop-outgrad-loop</data>
          <data key="d_label">iterate sorted graph, popping grads[node]</data>
          <data key="d_definition">The main backprop loop: for each node in reverse-topo order, pop its accumulated outgrad from a grads dict; if leaf, set .grad; else, run each parent's backward fn and accumulate into grads[parent].</data>
          <data key="d_domain">toposort-and-backprop</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#86F285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">iterate sorted graph, popping grads[node]</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="dispatch-back-fn-from-recipe">
          <data key="d_id">dispatch-back-fn-from-recipe</data>
          <data key="d_label">BACK_FUNCS.get_back_func(node.recipe.func, argnum)</data>
