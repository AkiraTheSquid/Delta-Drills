        <node id="linear-affine-on-custom-tensor">
          <data key="d_id">linear-affine-on-custom-tensor</data>
          <data key="d_label">x @ self.weight.T + self.bias</data>
          <data key="d_definition">The forward of the custom Linear: matmul against a transposed weight, optionally add a 1-D bias. Identical math to torch.nn.Linear but uses the custom @ and .T ops.</data>
          <data key="d_domain">custom-autograd-layers</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
