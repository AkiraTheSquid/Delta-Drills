          <data key="d_label">catch RuntimeError on solve</data>
          <data key="d_definition">Unbatched fallback for handling singular matrices: wrap linalg.solve in try/except and return a default; replaced by the mask trick once batched.</data>
          <data key="d_domain">linear-algebra</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">1</data>
