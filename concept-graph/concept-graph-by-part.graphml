        <node id="holdout-data-one-per-class">
          <data key="d_id">holdout-data-one-per-class</data>
          <data key="d_label">dict-of-class-to-image, then stack</data>
          <data key="d_definition">Construct a fixed HOLDOUT_DATA tensor of shape (10, 1, 28, 28) by iterating the test loader and keeping one example per MNIST class. Used to monitor reconstruction quality across all digit classes during training.</data>
