              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">Tensor(array, requires_grad, recipe, grad)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
