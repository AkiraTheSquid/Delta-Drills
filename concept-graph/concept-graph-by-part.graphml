              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">with NoGrad(): p -= ... during optimizer step</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
