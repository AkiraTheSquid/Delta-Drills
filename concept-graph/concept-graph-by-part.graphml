              <y:Fill color="#F285BD" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">with NoGrad(): for p in params: p -= p.grad * lr</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="no-grad-context-mgr-update">
          <data key="d_id">no-grad-context-mgr-update</data>
          <data key="d_label">with NoGrad(): p -= ... during optimizer step</data>
          <data key="d_definition">Parameter updates use the custom NoGrad context manager to flip grad_tracking_enabled off temporarily; analogous to torch.no_grad() around optimizer.step().</data>
          <data key="d_domain">custom-autograd-layers</data>
          <data key="d_status">accepted</data>
