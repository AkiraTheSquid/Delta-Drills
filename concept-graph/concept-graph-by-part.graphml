        <node id="clip-grad-norm-pre-step">
          <data key="d_id">clip-grad-norm-pre-step</data>
          <data key="d_label">nn.utils.clip_grad_norm_(params, max_norm)</data>
          <data key="d_definition">Clip the global gradient norm of a parameter group to a max value, called between loss.backward() and optimizer.step(). Standard GAN-stability tool; clip_grad_norm: float | None = 1.0 is a default arg.</data>
          <data key="d_domain">gan-training</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-?</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#85F2AE" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">nn.utils.clip_grad_norm_(params, max_norm)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="dcgan-normal-init-002">
          <data key="d_id">dcgan-normal-init-002</data>
          <data key="d_label">nn.init.normal_(w, 0.0, 0.02)</data>
          <data key="d_definition">Per the DCGAN paper, init all Conv / ConvTranspose / Linear weights from N(0, 0.02). The 'magic number' init that makes DCGANs converge.</data>
          <data key="d_domain">dcgan-init</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="256.0" x="0.0" y="0.0"/>
              <y:Fill color="#D485F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">nn.init.normal_(w, 0.0, 0.02)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="bn-weight-bias-init-pattern">
          <data key="d_id">bn-weight-bias-init-pattern</data>
          <data key="d_label">BN weight ~ N(1, 0.02), bias = 0</data>
          <data key="d_definition">BatchNorm layers get their multiplicative weight initialized around 1 (not 0, since BN multiplies), and the additive bias set to exactly zero. Always paired with dcgan-normal-init-002 in DCGAN init.</data>
          <data key="d_domain">dcgan-init</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#D485F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">BN weight ~ N(1, 0.02), bias = 0</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="module-modules-iter-isinstance-dispatch">
          <data key="d_id">module-modules-iter-isinstance-dispatch</data>
          <data key="d_label">for m in model.modules(): isinstance(m, ...)</data>
          <data key="d_definition">Walk the full module tree with .modules(), then dispatch initialization (or any per-type op) using isinstance(m, (Conv2d, Linear, ...)). The canonical 'do something to every layer of a specific type' idiom.</data>
          <data key="d_domain">dcgan-init</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#D485F2" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">for m in model.modules(): isinstance(m, ...)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="convT-as-flipped-padded-conv">
          <data key="d_id">convT-as-flipped-padded-conv</data>
          <data key="d_label">pad(k-1) + flip kernel -&gt; conv</data>
          <data key="d_definition">Core identity: a transposed convolution (no stride, no padding) equals a regular convolution with (k-1) zero-padding on each side AND the kernel flipped along its spatial axes. The mathematical key that lets you implement convT in terms of conv.</data>
          <data key="d_domain">transposed-convolution</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#ADF285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">pad(k-1) + flip kernel -&gt; conv</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="convT-kernel-axis-swap">
          <data key="d_id">convT-kernel-axis-swap</data>
          <data key="d_label">rearrange 'i o k -&gt; o i k'</data>
          <data key="d_definition">Transposed-conv kernels store channels as (in, out, kernel...) (opposite of conv's (out, in, kernel...)); conversion to a conv-compatible kernel is an einops rearrange swapping the first two axes, applied after the spatial flip.</data>
          <data key="d_domain">transposed-convolution</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="232.0" x="0.0" y="0.0"/>
              <y:Fill color="#ADF285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">rearrange 'i o k -&gt; o i k'</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="fractional-stride-zero-insertion">
          <data key="d_id">fractional-stride-zero-insertion</data>
          <data key="d_label">insert (s-1) zeros between input elements</data>
          <data key="d_definition">Stride-s transposed conv = insert (s-1) zeros between every pair of adjacent input elements, THEN do a stride-1 transposed conv. Implemented by allocating a zeros tensor of the spaced shape, then x_new[..., ::s] = x. The 'fractional stride' that turns convT into an upsampler.</data>
          <data key="d_domain">transposed-convolution</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#ADF285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">insert (s-1) zeros between input elements</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="padding-amount-formula-convT">
          <data key="d_id">padding-amount-formula-convT</data>
          <data key="d_label">pad_actual = k - 1 - padding</data>
          <data key="d_definition">The padding kwarg on conv_transpose SUBTRACTS from the implicit (k-1) zero-padding (rather than adding to it like in regular conv). The non-obvious sign-flip that trips everyone up.</data>
          <data key="d_domain">transposed-convolution</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="248.0" x="0.0" y="0.0"/>
              <y:Fill color="#ADF285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">pad_actual = k - 1 - padding</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="convT-init-uniform-by-kernel">
          <data key="d_id">convT-init-uniform-by-kernel</data>
          <data key="d_label">sf = 1/sqrt(out * kH * kW); Unif[-sf, sf]</data>
          <data key="d_definition">PyTorch's ConvTranspose2d weight init: uniform [-sqrt(k), sqrt(k)] with k = 1 / (out_channels * kernel_h * kernel_w). Note the denominator uses out_channels, mirroring the fan-out convention (vs Linear's fan-in).</data>
          <data key="d_domain">transposed-convolution</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#ADF285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">sf = 1/sqrt(out * kH * kW); Unif[-sf, sf]</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="mse-reconstruction-loss">
          <data key="d_id">mse-reconstruction-loss</data>
          <data key="d_label">nn.MSELoss()(img, img_reconstructed)</data>
          <data key="d_definition">Standard pixel-wise L2 loss between an input and its reconstruction; used in autoencoder and VAE training. Applied to raw tensors, no per-pixel reduction kwargs needed.</data>
          <data key="d_domain">generative-training-scaffold</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-?</data>
          <data key="d_part">5</data>
      <data key="d_group">part-5</data>
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="40.0" width="260.0" x="0.0" y="0.0"/>
              <y:Fill color="#CBF285" transparent="false"/>
              <y:BorderStyle color="#1a1a1a" raised="false" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">nn.MSELoss()(img, img_reconstructed)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="log-samples-eval-callback">
          <data key="d_id">log-samples-eval-callback</data>
          <data key="d_label">@t.inference_mode() log_samples(self)</data>
          <data key="d_definition">Trainer method that runs the model in inference mode on holdout data (or generates from random noise for GANs), normalizes output to uint8, and logs as wandb.Image(...). Called every args.log_every_n_steps. The 'watch your model train' hook.</data>
          <data key="d_domain">generative-training-scaffold</data>
