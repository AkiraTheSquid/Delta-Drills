        </node>
        <node id="sgd-vanilla-from-scratch">
          <data key="d_id">sgd-vanilla-from-scratch</data>
          <data key="d_label">with NoGrad(): for p in params: p -= p.grad * lr</data>
          <data key="d_definition">Minimal SGD on the custom Tensor: zero_grad sets all p.grad = None, step subtracts p.grad * lr in place under NoGrad() to keep the update off the autograd graph.</data>
          <data key="d_domain">custom-autograd-layers</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
