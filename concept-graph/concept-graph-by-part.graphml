        <node id="singular-matrix-mask-trick">
          <data key="d_id">singular-matrix-mask-trick</data>
          <data key="d_label">replace singular with identity</data>
          <data key="d_definition">Compute det, mark |det| &lt; eps as singular, set mat[is_singular] = t.eye(n) so batched solve doesn't throw, then AND-out singular results at the end.</data>
          <data key="d_domain">linear-algebra</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">1</data>
      <data key="d_group">part-1</data>
