              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" verticalTextPosition="bottom" visible="true">logprobs = logits - logsumexp(logits, dim=-1)</y:NodeLabel>
              <y:Shape type="roundrectangle"/>
            </y:ShapeNode>
          </data>
        </node>
        <node id="arange-fancy-index-cross-entropy">
          <data key="d_id">arange-fancy-index-cross-entropy</data>
          <data key="d_label">logprobs[arange(0, B), true_labels]</data>
          <data key="d_definition">Canonical 'pick the correct class per row' idiom: a length-B aranged index along axis 0, plus the int label tensor along axis 1, gives a length-B vector of correct-class logprobs.</data>
          <data key="d_domain">custom-autograd-layers</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
          <data key="d_part">4</data>
      <data key="d_group">part-4</data>
