        <node id="kaiming-uniform-sf-init">
          <data key="d_id">kaiming-uniform-sf-init</data>
          <data key="d_label">sf = in_features**-0.5; rand in [-sf, sf]</data>
          <data key="d_definition">Linear weight init: scale uniform [-sf, sf] with sf = 1/sqrt(in_features) (fan-in Kaiming/He uniform); same scheme for bias.</data>
          <data key="d_domain">custom-autograd-layers</data>
          <data key="d_status">accepted</data>
          <data key="d_dd_coverage">DD-N</data>
