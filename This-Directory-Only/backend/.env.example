# Supabase — used to fetch per-user OpenAI API keys from the user_settings table.
# SUPABASE_URL is the project API URL (safe to commit).
# SUPABASE_SERVICE_ROLE_KEY is the secret service-role key — never commit it; add to .env only.
SUPABASE_URL=https://qaxtcaoydbpigomnfjpl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Sign in with Google — the OAuth 2.0 Web Client ID, which must match
# Local_Deployed_Shared/auth-config.js. Public (it ships to every browser), so
# it is committed here. Leave empty and /auth/google answers 503
# "Google sign-in is not configured on the server."
GOOGLE_CLIENT_ID=974393489971-95s4svmsafosm4uj4ihrp36v91j1vh73.apps.googleusercontent.com
