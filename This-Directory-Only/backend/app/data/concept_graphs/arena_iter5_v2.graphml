      <data key="d_topic">Backprop</data>
      <data key="d_subtopic">Backprop</data>
      <data key="d_tier">core</data>
      <data key="d_desc">dL/dx = dL/dout * d(out)/dx; backward functions implement the local Jacobian piece and multiply by incoming grad_out.</data>
