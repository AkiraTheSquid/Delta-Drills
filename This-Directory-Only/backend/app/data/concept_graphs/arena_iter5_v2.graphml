    <node id="boolean-mask-identity-replace">
      <data key="d_label">Singular-matrix identity substitution trick</data>
      <data key="d_topic">Ray Tracing</data>
      <data key="d_subtopic">Ray Tracing</data>
      <data key="d_tier">core</data>
      <data key="d_desc">For batched linear solves, detect singular sub-matrices, replace them with the identity so solve does not throw, then mask out their fake solutions in the final boolean.</data>
