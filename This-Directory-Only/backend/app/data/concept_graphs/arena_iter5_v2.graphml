      <data key="d_subtopic">Ray Tracing</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Reshape/permute/reorder tensor axes via a pattern string like `&quot;frames (y z) -&gt; frames y z&quot;`, naming axes for clarity.</data>
