    <node id="backward-function">
      <data key="d_label">Per-op backward function signature</data>
      <data key="d_topic">Backprop</data>
      <data key="d_subtopic">Backprop</data>
      <data key="d_tier">core</data>
      <data key="d_desc">For each forward op out = f(x, ...), a backward function takes (grad_out, out, *inputs) and returns dL/dx; uses &#x27;out&#x27; when expressing the gradient via the output saves recomputation (e.g. exp).</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="280.0" x="0.0" y="0.0"/>
