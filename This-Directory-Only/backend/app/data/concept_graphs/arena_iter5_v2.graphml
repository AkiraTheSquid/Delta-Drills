  <key for="node" id="d6" yfiles.type="nodegraphics"/>
  <key for="edge" id="d_conf" attr.name="confidence" attr.type="double"/>
  <key for="edge" id="d_hard" attr.name="is_hard_gate" attr.type="boolean"/>
  <key for="edge" id="d_rat" attr.name="rationale" attr.type="string"/>
  <key for="edge" id="d10" yfiles.type="edgegraphics"/>
  <graph id="G" edgedefault="directed">
    <node id="cross-entropy-loss">
      <data key="d_label">Cross-entropy loss</data>
      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Logits are pre-softmax real-valued scores; cross-entropy / max-likelihood are computed on logits directly to avoid the loss of precision from softmax.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="172.0" x="0.0" y="0.0"/>
        <y:Fill color="#AF9FF4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">Cross-entropy loss</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="torch-linalg-solve">
      <data key="d_label">torch.linalg.solve</data>
      <data key="d_topic">Ray Tracing</data>
      <data key="d_subtopic">Ray Tracing</data>
      <data key="d_tier">core</data>
      <data key="d_desc">torch.linalg.solve raises a RuntimeError when the coefficient matrix is singular (e.g. ray and segment are exactly parallel); this must be caught or otherwise handled.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="172.0" x="0.0" y="0.0"/>
        <y:Fill color="#9FA1F4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">torch.linalg.solve</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="training-loop-skeleton">
      <data key="d_label">optimizer.zero_grad()</data>
      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Setting param.grad = None is preferred over zeroing the existing tensor: it saves memory and is the PyTorch convention; the next .backward() re-creates it.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="196.0" x="0.0" y="0.0"/>
        <y:Fill color="#AF9FF4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">optimizer.zero_grad()</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="conv-output-size-formula">
      <data key="d_label">Conv output size formula</data>
      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">output_size = 1 + (input_size + 2*padding - kernel_size) // stride along each spatial dim; derivable from how the kernel slides over the input.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="220.0" x="0.0" y="0.0"/>
        <y:Fill color="#AF9FF4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">Conv output size formula</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="adam-bias-correction">
      <data key="d_label">Adam update rule</data>
      <data key="d_topic">Optimization</data>
      <data key="d_subtopic">Optimization</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Combines Adam-style EMA of first moment m_t and second moment v_t with bias correction (1 - beta^t), giving a per-parameter, momentum-like, adaptive optimizer.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="156.0" x="0.0" y="0.0"/>
        <y:Fill color="#F4CA9F" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">Adam update rule</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="vae-reparameterization-trick">
      <data key="d_label">Reparameterization trick</data>
      <data key="d_topic">VAEs and GANs</data>
      <data key="d_subtopic">VAEs and GANs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Instead of a single latent vector the encoder outputs a Gaussian parameterized by mean and log std; using log_sigma keeps sigma positive automatically.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="220.0" x="0.0" y="0.0"/>
        <y:Fill color="#9FD2F4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">Reparameterization trick</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="wandb-sweep-config">
      <data key="d_label">wandb sweep configuration</data>
      <data key="d_topic">Optimization</data>
      <data key="d_subtopic">Optimization</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Dict-of-distributions specifying hyperparameter search: method (random/grid/bayes), metric (name+goal), and parameters (per-hparam distribution).</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="228.0" x="0.0" y="0.0"/>
        <y:Fill color="#F4CA9F" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">wandb sweep configuration</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="wandb-watch-gradients">
      <data key="d_label">wandb.init / watch / log / finish</data>
      <data key="d_topic">Optimization</data>
      <data key="d_subtopic">Optimization</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Initialize a run with wandb.init(project,name,config), call wandb.watch(model) to log gradients/params, wandb.log({k:v}, step=...) to record metrics, and wandb.finish() at the end.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="280.0" x="0.0" y="0.0"/>
        <y:Fill color="#F4CA9F" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">wandb.init / watch / log / finish</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="adamw-decoupled-weight-decay">
      <data key="d_label">AdamW decoupled weight decay</data>
      <data key="d_topic">Optimization</data>
      <data key="d_subtopic">Optimization</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Apply weight decay directly to the parameters (theta *= 1 - lr * lambda) instead of adding into the gradient; this is the &#x27;correct&#x27; form mathematically equivalent to a Gaussian prior.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="252.0" x="0.0" y="0.0"/>
        <y:Fill color="#F4CA9F" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">AdamW decoupled weight decay</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="batchnorm-running-stats-ema">
      <data key="d_label">BatchNorm2d channel-wise normalization</data>
      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">BatchNorm tracks per-channel mean and variance via exponentially weighted moving averages (controlled by momentum); these buffers are used at eval time instead of batch statistics.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="280.0" x="0.0" y="0.0"/>
        <y:Fill color="#AF9FF4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">BatchNorm2d channel-wise normalization</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="torch-stack-vs-cat">
      <data key="d_label">torch.cat existing dimension</data>
      <data key="d_topic">Ray Tracing</data>
      <data key="d_subtopic">Ray Tracing</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Combine a list of equally-shaped tensors into a new tensor with an additional leading dim (controlled by `dim`); building block for assembling matrices and time series.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="252.0" x="0.0" y="0.0"/>
        <y:Fill color="#9FA1F4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">torch.cat existing dimension</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="vae-total-loss">
      <data key="d_label">VAE total loss = reconstruction + KL</data>
      <data key="d_topic">VAEs and GANs</data>
      <data key="d_subtopic">VAEs and GANs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">VAE training minimizes the negative Evidence Lower Bound: -ELBO = reconstruction term + KL divergence between encoder posterior and prior; treats VAE as variational inference.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="280.0" x="0.0" y="0.0"/>
        <y:Fill color="#9FD2F4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">VAE total loss = reconstruction + KL</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="dataloader-batching">
      <data key="d_label">DataLoader for batched iteration</data>
      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Train loaders should shuffle each epoch to decorrelate batches; test loaders generally pass shuffle=False because order does not matter for metrics.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="280.0" x="0.0" y="0.0"/>
        <y:Fill color="#AF9FF4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">DataLoader for batched iteration</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="gan-loss-log-d">
      <data key="d_label">GAN minimax loss</data>
      <data key="d_topic">VAEs and GANs</data>
      <data key="d_subtopic">VAEs and GANs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">GAN discriminator loss is implicitly BCE on logits-of-real-vs-fake (computed manually here via log D(x) and log(1-D(G(z))) terms).</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="156.0" x="0.0" y="0.0"/>
        <y:Fill color="#9FD2F4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">GAN minimax loss</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="inference-mode-context">
      <data key="d_label">torch.inference_mode context</data>
      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Suppress autograd graph creation for a block; common alternative to inference_mode for code that runs under user-facing autograd semantics.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="252.0" x="0.0" y="0.0"/>
        <y:Fill color="#AF9FF4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">torch.inference_mode context</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="nn-parameter">
      <data key="d_label">nn.Parameter wrapper</data>
      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Wrapping a tensor in nn.Parameter registers it as a learnable parameter inside a Module so it appears in .parameters() and gets updated by optimizers.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="188.0" x="0.0" y="0.0"/>
        <y:Fill color="#AF9FF4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">nn.Parameter wrapper</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="stride-zero-broadcast">
      <data key="d_label">Stride tuple semantics</data>
      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">A tensor&#x27;s stride tuple gives the number of memory elements to step when advancing one position in each dimension. Storage layout is independent of shape.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="204.0" x="0.0" y="0.0"/>
        <y:Fill color="#AF9FF4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">Stride tuple semantics</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="tensor-grad-attribute">
      <data key="d_label">Tensor.grad attribute</data>
      <data key="d_topic">Optimization</data>
      <data key="d_subtopic">Optimization</data>
      <data key="d_tier">core</data>
      <data key="d_desc">After loss.backward(), every leaf parameter with requires_grad=True has a .grad tensor of the same shape; this is what optimizers update.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="196.0" x="0.0" y="0.0"/>
        <y:Fill color="#F4CA9F" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">Tensor.grad attribute</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="conv-as-einsum">
      <data key="d_label">1D convolution via strided expansion</data>
      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Materialize a (B, C, oh, ow, kh, kw) view of the input where the (oh, ow) axes are sliding window positions; combined with einsum it yields the convolution result.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="280.0" x="0.0" y="0.0"/>
        <y:Fill color="#AF9FF4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">1D convolution via strided expansion</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="force-pair-int-or-tuple">
      <data key="d_label">force_pair helper / IntOrPair type</data>
      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Helper that normalises a hyperparameter that may be either an int or a tuple of two ints into a (h, w) pair; used for stride, padding, kernel_size.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="280.0" x="0.0" y="0.0"/>
        <y:Fill color="#AF9FF4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">force_pair helper / IntOrPair type</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="fractional-stride">
      <data key="d_label">fractional_stride_1d insert zeros</data>
      <data key="d_topic">VAEs and GANs</data>
      <data key="d_subtopic">VAEs and GANs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Insert stride-1 zeros between input elements before applying a minimal transposed conv; equivalent to taking strides of 1/stride over the output (hence &#x27;fractionally strided&#x27;).</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="280.0" x="0.0" y="0.0"/>
        <y:Fill color="#9FD2F4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">fractional_stride_1d insert zeros</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="padding-with-new-full">
      <data key="d_label">Padding via new_full + slice copy</data>
      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Implement padding by allocating a larger tensor pre-filled with pad_value and writing the input into the appropriate slice; avoids per-stride edge-case arithmetic.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="280.0" x="0.0" y="0.0"/>
        <y:Fill color="#AF9FF4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">Padding via new_full + slice copy</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="dcgan-architecture">
      <data key="d_label">DCGAN architecture</data>
      <data key="d_topic">VAEs and GANs</data>
      <data key="d_subtopic">VAEs and GANs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Generator stack: project+reshape -&gt; repeated (ConvTranspose2d, BatchNorm, ReLU) -&gt; Tanh. Discriminator mirror: (Conv2d, BatchNorm, LeakyReLU) -&gt; flatten + Linear + Sigmoid. Activation size doubles per layer.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="172.0" x="0.0" y="0.0"/>
        <y:Fill color="#9FD2F4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">DCGAN architecture</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="detach-for-discriminator-step">
      <data key="d_label">Detach fake image for D step</data>
      <data key="d_topic">VAEs and GANs</data>
      <data key="d_subtopic">VAEs and GANs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">When training the discriminator on G&#x27;s output, pass img_fake.detach() so gradients do not flow back into G during the D step; keeps G&#x27;s update isolated.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="252.0" x="0.0" y="0.0"/>
        <y:Fill color="#9FD2F4" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">Detach fake image for D step</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="determinant-singularity-test">
      <data key="d_label">torch.linalg.det</data>
      <data key="d_topic">Ray Tracing</data>
      <data key="d_subtopic">Ray Tracing</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Detect singular matrices in a batch by computing their determinant and checking |det| &lt; threshold; standard prelude to safe batched solves.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="156.0" x="0.0" y="0.0"/>
