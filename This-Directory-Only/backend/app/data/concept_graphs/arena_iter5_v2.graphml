      <data key="d_topic">Ray Tracing</data>
      <data key="d_subtopic">Ray Tracing</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Points inside a triangle ABC are parametrized as A + u(B-A) + v(C-A) with u,v&gt;=0 and u+v&lt;=1.</data>
