    <node id="ray-segment-intersection-linear-system">
      <data key="d_label">2D ray-segment 2x2 linear system</data>
      <data key="d_topic">Ray Tracing</data>
      <data key="d_subtopic">Ray Tracing</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Setting the ray equation equal to the line equation reduces ray-segment intersection to solving a 2x2 linear system for (u, v) and checking u&gt;=0, v in [0,1].</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="280.0" x="0.0" y="0.0"/>
