        <y:Geometry height="42.0" width="252.0" x="0.0" y="0.0"/>
        <y:Fill color="#F4CA9F" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">Gradient descent update rule</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
