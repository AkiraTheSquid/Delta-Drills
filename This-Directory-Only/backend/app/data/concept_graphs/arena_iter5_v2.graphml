      <data key="d_topic">Ray Tracing</data>
      <data key="d_subtopic">Ray Tracing</data>
      <data key="d_tier">core</data>
      <data key="d_desc">After computing per-(ray, triangle) intersection distances, reduce over the triangle axis with `min` to get each ray&#x27;s closest hit (or +inf if it misses everything).</data>
