      <data key="d_topic">CNNs</data>
      <data key="d_subtopic">CNNs</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Maxpool reduces spatial resolution and surfaces dominant features; e.g. a wheel detector cares about presence anywhere in the receptive field.</data>
