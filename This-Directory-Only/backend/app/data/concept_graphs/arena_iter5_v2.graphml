      <data key="d_subtopic">Backprop</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Iterate the computational graph in reverse-topological order, pulling each node&#x27;s outgrad from a dict, calling back_funcs for each parent, accumulating their grads.</data>
      <data key="d6"><y:ShapeNode>
