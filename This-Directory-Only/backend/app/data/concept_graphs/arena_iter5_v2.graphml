      <data key="d_topic">Ray Tracing</data>
      <data key="d_subtopic">Ray Tracing</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Reducing ray-triangle intersection in 3D to a 3x3 linear system solve over (-D, B-A, C-A) for (s, u, v); intersection iff s&gt;=0, u&gt;=0, v&gt;=0, u+v&lt;=1.</data>
