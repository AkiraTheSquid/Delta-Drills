      <data key="d_subtopic">Ray Tracing</data>
      <data key="d_tier">core</data>
      <data key="d_desc">Reduce a tensor along named axes using `einops.reduce(t, pattern, op)` where op is one of &#x27;min&#x27;/&#x27;max&#x27;/&#x27;sum&#x27;/&#x27;mean&#x27;.</data>
      <data key="d6"><y:ShapeNode>
