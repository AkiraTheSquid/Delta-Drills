        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="rosenbrock-banana">
      <data key="d_label">Rosenbrock’s banana function</data>
      <data key="d_topic">Optimization</data>
      <data key="d_subtopic">Optimization</data>
      <data key="d_tier">core</data>
      <data key="d_desc">(a-x)^2 + b(y-x^2)^2 + 1 with global minimum at (a, a); features a long narrow parabolic valley along y=x^2 — classic optimizer benchmark.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="252.0" x="0.0" y="0.0"/>
        <y:Fill color="#F4CA9F" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">Rosenbrock’s banana function</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="sgd-momentum">
      <data key="d_label">SGD with momentum</data>
      <data key="d_topic">Optimization</data>
      <data key="d_subtopic">Optimization</data>
      <data key="d_tier">core</data>
      <data key="d_desc">b_t = mu*b_{t-1} + g_t accumulates an exponentially weighted history of gradients; used to smooth updates and accelerate along consistent directions.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="164.0" x="0.0" y="0.0"/>
        <y:Fill color="#F4CA9F" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">SGD with momentum</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="sgd-update-rule">
      <data key="d_label">Gradient descent update rule</data>
      <data key="d_topic">Optimization</data>
      <data key="d_subtopic">Optimization</data>
      <data key="d_tier">core</data>
      <data key="d_desc">θ_t ← θ_{t-1} - λ ∇L(θ_{t-1}); subtract the gradient times the learning rate to take a finite step in the descent direction.</data>
