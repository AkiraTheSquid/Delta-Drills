    <node id="in-place-vs-graph-safety">
      <data key="d_label">In-place updates and graph safety</data>
      <data key="d_topic">Backprop</data>
      <data key="d_subtopic">Backprop</data>
      <data key="d_tier">core</data>
      <data key="d_desc">If backward needs the pre-update value of a tensor and you mutated it in-place, the gradient will be wrong; PyTorch raises an error in obvious cases.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="280.0" x="0.0" y="0.0"/>
        <y:Fill color="#F49FF2" transparent="false"/>
        <y:BorderStyle color="#222222" raised="false" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" textColor="#000000" modelName="internal" modelPosition="c">In-place updates and graph safety</y:NodeLabel>
        <y:Shape type="roundrectangle"/>
