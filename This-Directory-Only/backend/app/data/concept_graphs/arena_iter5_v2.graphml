    <node id="rmsprop-update">
      <data key="d_label">RMSprop update rule</data>
      <data key="d_topic">Optimization</data>
      <data key="d_subtopic">Optimization</data>
      <data key="d_tier">core</data>
      <data key="d_desc">v_t = alpha*v_{t-1} + (1-alpha)*g_t^2; divide updates by sqrt(v_t)+eps so dimensions with historically large gradients move less.</data>
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="42.0" width="180.0" x="0.0" y="0.0"/>
        <y:Fill color="#F4CA9F" transparent="false"/>
