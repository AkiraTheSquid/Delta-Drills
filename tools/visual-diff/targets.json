      ],
      "link": [
        "[class*=\"PostsPage-postContent\"] p a",
        "[class*=\"PostsPage-postContent\"] a"
      ],
      "toc": [
        "[class*=\"FixedPositionToC-root\"]"
      ],
      "toc_title": [
        "[class*=\"FixedPositionToC-tocTitle\"]"
      ],
      "toc_row": [
        "[class*=\"FixedPositionToC-rowWrapper\"]:has([class~=\"FixedPositionToC-rowDot\"])"
      ],
      "toc_label": [
        "[class*=\"TableOfContentsRow-level2\"] [class*=\"TableOfContentsRow-link\"]"
      ],
      "toc_current": [
        "[class*=\"TableOfContentsRow-highlighted\"] [class*=\"TableOfContentsRow-link\"]",
        "[class*=\"TableOfContentsRow-highlighted\"]"
      ],
      "toc_dot": [
        "[class~=\"FixedPositionToC-rowDot\"]"
      ],
      "toc_progress": [
        "[class*=\"FixedPositionToC-progressBarContainer\"]"
      ],
      "toc_line": [
        "[class*=\"FixedPositionToC-rowDotContainer\"]"
      ],
      "toc_fade": [
        "[class*=\"FixedPositionToC-rowOpacity\"]"
      ],
      "toc_fill": [
        "[class~=\"FixedPositionToC-progressBar\"]"
      ],
      "toc_rows": [
        "[class*=\"FixedPositionToC-rows\"]"
      ],
      "toc_level": [
        "[class*=\"TableOfContentsRow-level2\"]"
      ]
    },
    "series": {
      "toc_rows": [
        "[class*=\"TableOfContentsRow-root\"]"
      ],
      "paras": [
        "[class*=\"PostsPage-postContent\"] p"
      ],
      "h2s": [
        "[class*=\"PostsPage-postContent\"] h2"
      ]
    }
  },
